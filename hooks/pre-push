#!/usr/bin/env bash
#
# Installed into the superproject by tools/install-hooks.sh.
#
# Blocks a push whose submodule gitlinks point at commits that are not on the
# submodule's remote. That is the failure mode worth blocking: the push
# succeeds, the dashboard looks fine, and every clone afterwards dies with
#
#   fatal: needed a single revision / unable to find <sha> in submodule path
#
# because the commit only ever existed on one laptop. Forgetting to bump a
# gitlink is merely stale; publishing an unreachable one is broken for everyone.
#
# Bypass once (you had better be sure):  git push --no-verify

set -u

SUPER="$(git rev-parse --show-toplevel)"
FAIL=0
STALE=()

while read -r _mode _type sha path; do
    [ -n "${path:-}" ] || continue
    [ -d "$SUPER/$path/.git" ] || [ -f "$SUPER/$path/.git" ] || continue   # not initialized

    # Refresh remote refs so containment is judged against reality, not a
    # stale cache. Offline: fall back to whatever is known locally.
    git -C "$SUPER/$path" fetch -q --no-tags origin 2>/dev/null || true

    if ! git -C "$SUPER/$path" cat-file -e "$sha^{commit}" 2>/dev/null; then
        printf '\033[31mBLOCKED\033[0m %s: gitlink %s does not exist in the submodule at all\n' "$path" "${sha:0:7}"
        FAIL=1
        continue
    fi

    if [ -z "$(git -C "$SUPER/$path" branch -r --contains "$sha" 2>/dev/null)" ]; then
        printf '\033[31mBLOCKED\033[0m %s: gitlink %s is not on any remote branch\n' "$path" "${sha:0:7}"
        printf '        push it first:  git -C %s push\n' "$path"
        FAIL=1
        continue
    fi

    HEAD_SHA="$(git -C "$SUPER/$path" rev-parse HEAD 2>/dev/null || true)"
    [ "$HEAD_SHA" = "$sha" ] || STALE+=("$path ${sha:0:7} -> ${HEAD_SHA:0:7}")
done < <(git ls-tree HEAD | awk '$2 == "commit"')

# Stale gitlinks are a warning, not a block: checking out an older submodule
# commit on purpose is legitimate.
if [ ${#STALE[@]} -gt 0 ]; then
    printf '\033[33mnote\033[0m  submodule checkout differs from the recorded gitlink:\n'
    printf '        %s\n' "${STALE[@]}"
    printf '      bump with:  git add <path> && git commit\n'
fi

[ "$FAIL" -eq 0 ] || {
    printf '\nPushing this would publish a submodule commit nobody else can fetch.\n' >&2
    exit 1
}
exit 0
